@import "catppuccin-mocha"

* {
    font: "JetBrains Mono Nerd Font 12";
    background-color: transparent;
    text-color: @text;
}

window {
    width: 600px;
    background-color: rgba(30, 30, 46, 0.85);
    border: 2px solid;
    border-color: @mauve;
    border-radius: 12px;
    location: center;
    padding: 12px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface0;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @mauve;
}

entry {
    text-color: @text;
    placeholder: "Search clipboard...";
    placeholder-color: @overlay0;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    scrollbar: true;
    fixed-height: true;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-color: @mauve;
    handle-width: 4px;
    background-color: @surface0;
    border-radius: 4px;
}

element {
    background-color: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface1;
    border: 1px solid;
    border-color: @mauve;
    text-color: @text;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold #cba6f7;
}
